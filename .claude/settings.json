{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run figma:inspect:*)",
      "Bash(node scripts/figma/inspect.mjs:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npm run figma:pull:*)",
      "Bash(node scripts/figma/pull.mjs:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env*.local)"
    ]
  }
}
